BROKER_MODE=demo
# safety_cases is the default portfolio; empty_account enables the full locked demo journey.
DEMO_PROFILE=safety_cases
IB_ENVIRONMENT=paper
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=17
# Dedicated client id for the read-only historical-data process (ADR-0011).
# Must differ from IB_CLIENT_ID; must be >= 1 (id 0 is the TWS master client id).
IB_DATA_CLIENT_ID=18
# Options forward-capture bounds (ADR-0012). The window is recorded in every snapshot,
# so anything outside it is absent by policy, not missing data.
OPTION_CAPTURE_EXPIRY_HORIZON_DAYS=120
OPTION_CAPTURE_STRIKE_WINDOW_PCT=0.20
# Holdout-unlock guardian (ADR-0013). Rations owner-typed, single-use holdout unlocks.
HOLDOUT_UNLOCK_TTL_MINUTES=15
HOLDOUT_SESSIONS_PER_UNLOCK=20
HOLDOUT_MAX_OUTSTANDING_UNLOCKS=2
# The unlock PHRASE is never a setting. `chronos holdout unlock` reads it from the env
# var CHRONOS_HOLDOUT_UNLOCK_PHRASE (not a --flag, so it stays out of process listings);
# it is never stored, logged, or echoed. It is not set here on purpose.
IB_ACCOUNT_ID=
ALLOW_ORDER_TRANSMIT=false
ALLOW_LIVE_TRADING=false
ALLOW_OUTSIDE_RTH=false
SYMBOL_ALLOWLIST=AAPL,MSFT,SPY
TARGET_ABS_DELTA=0.30
MIN_ABS_DELTA=0.20
MAX_ABS_DELTA=0.35
MIN_DTE=7
TARGET_DTE=21
MAX_DTE=45
# Hard safety caps: expirations <= 8, strikes <= 20, and their product <= 80.
MAX_EXPIRATIONS=6
MAX_STRIKES_PER_EXPIRATION=12
MIN_OPTION_VOLUME=10
MIN_OPEN_INTEREST=100
MAX_RELATIVE_SPREAD=0.20
MAX_QUOTE_AGE_SECONDS=5
MARKET_TIMEZONE=America/New_York
MAX_CONTRACTS_PER_ORDER=1
MAX_SYMBOL_ALLOCATION_PCT=0.25
MAX_TOTAL_WHEEL_ALLOCATION_PCT=0.60
DELTA_WEIGHT=0.45
SPREAD_WEIGHT=0.30
DTE_WEIGHT=0.15
LIQUIDITY_WEIGHT=0.10
ASSIGNMENT_NEAR_ZERO_EXTRINSIC=0.05
ASSIGNMENT_MEANINGFUL_EXTRINSIC=0.10
ASSIGNMENT_ELEVATED_ABS_DELTA=0.50
ASSIGNMENT_HIGH_DTE=3
ASSIGNMENT_ELEVATED_DTE=5
ASSIGNMENT_EX_DIVIDEND_WINDOW_DAYS=5
DATABASE_URL=sqlite:///data/chronos.db
LOG_LEVEL=INFO
LOG_FILE=logs/chronos.log

# --- Deterministic strategy platform (research/backtest/shadow/paper) ---
# The platform starts HALTED on a fresh deployment and every live-capable mode is
# refused by code regardless of any value written here.
#
# Removed 2026-08-02: PLATFORM_HALT_FILE, PLATFORM_AUDIT_FILE, PLATFORM_LEDGER_DB,
# PLATFORM_RISK_POLICY and PAPER_ACCOUNT_ALLOWLIST used to be listed here and were
# read by NOTHING — not a Settings field, not an os.environ lookup. Setting them
# did nothing at all.
#
# The platform's paths are CLI flags, not environment variables:
#   python -m chronos.service --halt-file ... --audit-file ... --policy ...
#   python -m chronos.cli --help
#
# PAPER_ACCOUNT_ALLOWLIST was the dangerous one, so it is worth naming. The
# allowlist it appeared to set is real and load-bearing — `chronos.control.modes`
# refuses paper execution when it is empty — but that gate is fed from
# IB_ACCOUNT_ALLOWLIST above (see submission.py, which passes
# settings.ib_account_allowlist into the mode lock). An operator who set the
# phantom variable and believed they had allowlisted an account had changed
# nothing. Fail-closed meant the worst case was a refusal rather than a wrong
# account, but a variable that reads like a safety control and is not one is the
# same shape as the four inert kernel defects (R-24..R-27), and it is gone.
#
# `tests/safety/test_env_example_has_no_phantom_settings.py` now fails if any
# variable listed in this file is read by nothing, so this cannot recur silently.

# --- Live-wheel backend (Milestone 1; docs/LIVE_WHEEL_GAME_PLAN.md) ---
# The FastAPI backend binds to loopback only and requires a local API token
# (auto-generated at BACKEND_TOKEN_FILE on first start; never commit it).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8765
BACKEND_TOKEN_FILE=data/backend_api_token

# Account allowlist for the live-wheel path (exact match required; empty = no
# account may ever transmit). Live trading is a gated capability (ADR-0009): it
# needs the full configuration conjunction plus the ten-gate stack at run time.
# Autonomous operation additionally requires an owner AutonomyMandate
# (ADR-0016/ADR-0017). AUTONOMY_MANDATE_FILE below names it; the file's
# content is the grant — this variable only points at it.
# Accepts a comma-separated list (DU1234567,DU7654321) or a JSON array
# (["DU1234567"]). EMPTY MEANS DENY — no account is permitted — which is the
# safe value and the shipped default; it is not "all accounts".
IB_ACCOUNT_ALLOWLIST=
ENABLE_PAPER_TRADING=true
REQUIRE_LIVE_ARMING=true
LIVE_ARM_TTL_MINUTES=15
REQUIRE_TYPED_CONFIRMATION=true
ORDER_CONFIRMATION_TTL_SECONDS=20
MAX_OPEN_SHORT_OPTION_CONTRACTS=5
MAX_OPENING_ORDERS_PER_DAY=3
MAX_GROSS_ASSIGNMENT_USD=25000
MIN_CASH_BUFFER_USD=5000
MIN_CASH_BUFFER_PCT=0.10
MIN_EXCESS_LIQUIDITY_USD=10000
MAX_SESSION_DRAWDOWN_USD=1000
MAX_SESSION_DRAWDOWN_PCT=0.02

# Crypto family (owner-directed scope; spot only, no options exist at IBKR).
# Empty allowlist keeps the family entirely disabled. IBKR paper accounts do
# not support crypto — see docs/LIVE_WHEEL_GAME_PLAN.md §6b.
# Same syntax as IB_ACCOUNT_ALLOWLIST: comma-separated or a JSON array.
CRYPTO_ALLOWLIST=
MAX_CRYPTO_ALLOCATION_PCT=0.10
MAX_CRYPTO_NOTIONAL_PER_ORDER_USD=1000

# --- IBKR adapter selection (Milestone 2) ---
# official_ibkr (production default; official TWS API installed per
# docs/ibkr_setup.md — never via pip) | ib_async (optional secondary).
# Ignored in BROKER_MODE=demo.
BROKER_ADAPTER=official_ibkr

# --- Autonomy (ADR-0017: persistent, auto-activating mandate) ---
# Path to the owner-authored AutonomyMandate JSON. Present and valid: it is
# loaded, digest-stamped, and AUTO-ACTIVATED on every boot — a running backend
# plus this file is enough to trade inside the mandate. Unset (the default):
# autonomy is inert and no runtime is constructed. A revoked mandate stays
# revoked across restarts; re-granting requires a new mandate_version in the
# file. An invalid or wrong-account file boots inert with a CRITICAL alert.
#AUTONOMY_MANDATE_FILE=data/autonomy_mandate.json
# Path to the owner-authored proposer registry JSON (ADR-0023). Unset (the
# default): proposals authenticate with the local API token and are stamped
# with the static ingress identity, exactly as before. Set: the proposal route
# requires a registered proposer credential (X-Chronos-Proposer-Token) — the
# general API token no longer suffices there — and provenance is stamped from
# the matching registration (provider, model, prompt/tool/schema/policy
# versions). Mint a credential + registration entry with:
#   python -m chronos.cli proposer mint --proposer-id claude-worker ...
# The file stores only credential HASHES; an invalid file refuses proposals.
#AUTONOMY_PROPOSERS_FILE=data/autonomy_proposers.json
# Per-job evidence binding (ADR-0028 Option C). Unset is today's behavior
# byte-for-byte: every proposal cites a placeholder bundle and admission's
# check 9 compares that constant against itself. Set, every proposal must cite
# an evidence bundle this backend ISSUED to that proposer and that has not
# expired against the drain's clock — the proposer asks for one at
# POST /autonomy/evidence with its proposer credential, and renders the served
# document verbatim so the digest it cites matches the record by construction.
#
# Requires AUTONOMY_PROPOSERS_FILE: a bundle is issued TO a credential, so
# setting this without a registry refuses EVERY proposal with a CRITICAL owner
# alert rather than falling back to the placeholder. Honest bound worth knowing
# before you turn it on: equality between the cited digest and the issued record
# catches accidental rendering drift, NOT a proposer that reasons on other text
# and cites the issued digest.
#AUTONOMY_EVIDENCE_BUNDLES=false
# How long an issued bundle stays citable, judged at the drain. A disclosed
# judgment, not a derived number: it must exceed worst-case gather -> model call
# -> POST -> queue wait -> drain latency, and a TTL below a worker's think time
# refuses everything (the safe direction, and a visible failure). Hard ceiling
# 3600; an out-of-range or unparsable value refuses to start.
#AUTONOMY_EVIDENCE_TTL_SECONDS=300
# JSONL file the alert delivery sink appends owner alerts to (0600, fsync'd).
AUTONOMY_ALERT_FILE=data/owner_alerts.jsonl
# Tick cadence: the idle interval between cycles, and the floor an event hint
# can pull the next tick forward to (never below; events coalesce).
AUTONOMY_IDLE_INTERVAL_SECONDS=60
AUTONOMY_MIN_INTERVAL_SECONDS=5
# IANA timezone whose calendar day bounds the mandate's session counters.
AUTONOMY_MARKET_TIMEZONE=America/New_York

# --- TradingView signal bridge (ADR-0026) ---
# These configure a SEPARATE process (`python -m chronos.bridge`), not the
# backend. The bridge turns a TradingView webhook into a candidate proposal and
# POSTs it to the backend's existing /autonomy/proposals endpoint. It holds no
# trading authority: everything downstream — admission, sizing, compilation, the
# full order handoff — is unchanged, and the mandate still bounds what any
# proposal can become. Leave this whole block unset and no bridge exists.
#
# Mandatory. The bridge refuses to start without them, because TradingView
# cannot set request headers, so this secret is the only gate in front of the
# webhook. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
#CHRONOS_TV_BRIDGE_SECRET=
# The backend's local API token (the contents of its api_token file).
#CHRONOS_TV_BRIDGE_API_TOKEN=
# The bridge's registered proposer credential (ADR-0023). Required once the
# backend sets AUTONOMY_PROPOSERS_FILE; ignored by a pre-registry backend.
# Mint with: python -m chronos.cli proposer mint --proposer-id tradingview-bridge ...
#CHRONOS_TV_BRIDGE_PROPOSER_TOKEN=
# Deny-by-default allowlists. Empty means nothing is translatable, never
# everything, and the bridge refuses to start rather than relay anything.
#CHRONOS_TV_BRIDGE_SYMBOLS=SPY,IWM
#CHRONOS_TV_BRIDGE_KINDS=OPEN,CLOSE,HOLD
#
# Off by default: the bridge authenticates, parses, translates and logs, and
# sends NOTHING until this is true. Run it in that posture first and read what
# it would have proposed.
#CHRONOS_TV_BRIDGE_FORWARD=false
#
# Where the listener binds. Loopback by default; reaching TradingView requires a
# tunnel or reverse proxy the owner runs and is responsible for.
#CHRONOS_TV_BRIDGE_HOST=127.0.0.1
#CHRONOS_TV_BRIDGE_PORT=8109
# Must be loopback: the bridge posts carrying the backend's own API token.
#CHRONOS_TV_BRIDGE_INGRESS_URL=http://127.0.0.1:8000/autonomy/proposals
# Where the bridge records its alert attestation (ADR-0028). Loopback-bound like
# the ingress. Used only when the backend has AUTONOMY_EVIDENCE_BUNDLES set; a
# backend with it unset answers 404 and the bridge proceeds unchanged. What the
# record can honestly claim is narrow: this credential asserted, at this time,
# that it received an alert with this digest. Chronos never saw the alert, so
# the record is non-repudiation, not verification — an attested bundle may back
# a proposal and never a promotion rung.
#CHRONOS_TV_BRIDGE_EVIDENCE_URL=http://127.0.0.1:8000/autonomy/evidence
# Bounds on a chatty or replayed signal source.
#CHRONOS_TV_BRIDGE_MAX_ALERTS_PER_MINUTE=10
#CHRONOS_TV_BRIDGE_MAX_ALERT_AGE_SECONDS=120
#CHRONOS_TV_BRIDGE_REPLAY_WINDOW_SECONDS=3600
