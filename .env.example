BROKER_MODE=demo
# safety_cases is the default portfolio; empty_account enables the full locked demo journey.
DEMO_PROFILE=safety_cases
IB_ENVIRONMENT=paper
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=17
IB_ACCOUNT_ID=
ALLOW_ORDER_TRANSMIT=false
ALLOW_LIVE_TRADING=false
ALLOW_OUTSIDE_RTH=false
SYMBOL_ALLOWLIST=AAPL,MSFT,SPY
TARGET_ABS_DELTA=0.30
MIN_ABS_DELTA=0.20
MAX_ABS_DELTA=0.35
MIN_DTE=7
TARGET_DTE=21
MAX_DTE=45
# Hard safety caps: expirations <= 8, strikes <= 20, and their product <= 80.
MAX_EXPIRATIONS=6
MAX_STRIKES_PER_EXPIRATION=12
MIN_OPTION_VOLUME=10
MIN_OPEN_INTEREST=100
MAX_RELATIVE_SPREAD=0.20
MAX_QUOTE_AGE_SECONDS=5
MARKET_TIMEZONE=America/New_York
MAX_CONTRACTS_PER_ORDER=1
MAX_SYMBOL_ALLOCATION_PCT=0.25
MAX_TOTAL_WHEEL_ALLOCATION_PCT=0.60
DELTA_WEIGHT=0.45
SPREAD_WEIGHT=0.30
DTE_WEIGHT=0.15
LIQUIDITY_WEIGHT=0.10
ASSIGNMENT_NEAR_ZERO_EXTRINSIC=0.05
ASSIGNMENT_MEANINGFUL_EXTRINSIC=0.10
ASSIGNMENT_ELEVATED_ABS_DELTA=0.50
ASSIGNMENT_HIGH_DTE=3
ASSIGNMENT_ELEVATED_DTE=5
ASSIGNMENT_EX_DIVIDEND_WINDOW_DAYS=5
DATABASE_URL=sqlite:///data/chronos.db
LOG_LEVEL=INFO
LOG_FILE=logs/chronos.log

# --- Deterministic strategy platform (research/backtest/shadow/paper) ---
# Placeholders only. Never commit a real .env. The platform starts HALTED on a
# fresh deployment and every live-capable mode is refused by code regardless of
# any value written here.
PLATFORM_HALT_FILE=data/platform_halt.json
PLATFORM_AUDIT_FILE=data/platform_audit.jsonl
PLATFORM_LEDGER_DB=data/platform_ledger.db
PLATFORM_RISK_POLICY=config/risk.yaml
# Paper execution requires ALL of: TRADING allowed by mode lock, this allowlist
# non-empty, the broker-reported DU/DF account on it, broker-verified paper
# environment, and ALLOW_ORDER_TRANSMIT=true. Leave empty by default.
PAPER_ACCOUNT_ALLOWLIST=
