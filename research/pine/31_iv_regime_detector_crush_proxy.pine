//@version=6
// =============================================================================
// IV Regime Detector & Crush Proxy v1.0 (5T Pine Suite · Desk Kit)
//
// READ THIS FIRST — WHAT THIS IS NOT.
// TradingView standard data feeds carry NO per-symbol implied volatility.
// There is no options chain here, no IV for the ticker on your chart, and
// this script will not pretend otherwise. What it reads is the INDEX
// volatility complex — by default CBOE:VIX (30-day S&P 500 implied vol) and
// CBOE:VIX3M (93-day) — as broad-market context. If your chart is a single
// stock, this panel describes the S&P option market's weather, NOT your
// symbol's IV. Both symbols are inputs; if your data plan cannot see one,
// the affected rows degrade to n/a and say so rather than invent numbers.
// Never options advice. Decision support only — a human places every trade.
//
// WHAT IT DOES.
//   1. VIX percentile: the last COMPLETED daily VIX close ranked against the
//      prior 252 completed daily closes (ta.percentrank inside the daily
//      security context, then [1]-offset — fixed history, non-repaint).
//   2. Term structure: VIX / VIX3M. Ratio > 1 = backwardation (near-term
//      fear priced above 3-month) — the classic stress signature, labeled.
//   3. IV-regime state, a LABELED HEURISTIC: LOW (< 25th pctile) / NORMAL /
//      ELEVATED (>= 75th) / STRESS (>= 90th); backwardation escalates the
//      state one notch. The cuts are desk conventions, not fitted values.
//   4. "Crush proxy" — counted decay episodes: each time the percentile
//      crosses up through the stress cut a watch opens; when it falls back
//      below the exit cut (default 70) the episode completes and its length
//      in DAYS is stored (ring of 50). The HUD reports median + n. This is
//      counted history of how past spikes on THIS data decayed. It is NOT a
//      prediction of the current spike — vol can stay elevated far longer
//      than any median, and n is small by construction.
//
// Non-repaint: all index values are [1]-offset completed daily bars fetched
// with lookahead_on (the standard fixed-history idiom); state changes and
// episode counting advance on confirmed bars at day boundaries only.
//
// v1.0 changelog (2026-07-17):
//   Initial release. Index-vol-complex reader (VIX + VIX3M symbol inputs,
//   ignore_invalid_symbol=true degradation to n/a), 252d percentile, term
//   ratio with backwardation flag, LOW/NORMAL/ELEVATED/STRESS heuristic
//   state with escalation-only alerts, counted crush-decay episodes
//   (median days + n, thin-sample flag below 5), optional regime-link
//   context row, tiered HUD with honesty footer, data-window exports,
//   JSON alerts (default OFF). Evidence label: needs user run.
// =============================================================================
indicator("IV Regime Detector & Crush Proxy v1.0", shorttitle = "IV Proxy v1", overlay = false)

grp_mode = "0 · Mode"
grp_src  = "1 · Index Vol Sources"
grp_st   = "2 · State Heuristic"
grp_link = "3 · Integration Links"
grp_dsp  = "4 · Display"

variant_tag = input.string("v1.0-base", "Variant tag (freeze-the-config discipline)", group = grp_mode,
     tooltip = "Label this exact settings set. Any settings change = new tag = new variant with its own validation cycle. The tag prints on the HUD and in alerts so screenshots self-document.")

vix_sym = input.symbol("CBOE:VIX", "Near-term index vol symbol", group = grp_src,
     tooltip = "Default CBOE:VIX (30-day S&P 500 implied vol). This is INDEX context, not your chart symbol's IV — TradingView standard feeds carry no per-symbol IV. If your plan cannot see this symbol, rows degrade to n/a.")
vix3m_sym = input.symbol("CBOE:VIX3M", "3-month index vol symbol", group = grp_src,
     tooltip = "Default CBOE:VIX3M (93-day). Used only for the term ratio; if unavailable the ratio reads n/a and the state heuristic runs without the backwardation escalation.")
pct_len = input.int(252, "Percentile lookback (completed days)", minval = 60, maxval = 1000, group = grp_src)

cut_low = input.float(25.0, "LOW below percentile", minval = 1.0, maxval = 49.0, step = 1.0, group = grp_st)
cut_elev = input.float(75.0, "ELEVATED at/above percentile", minval = 50.0, maxval = 89.0, step = 1.0, group = grp_st)
cut_stress = input.float(90.0, "STRESS at/above percentile", minval = 80.0, maxval = 99.0, step = 1.0, group = grp_st,
     tooltip = "Percentile cuts are desk conventions, not fitted thresholds. Backwardation (VIX/VIX3M > 1) escalates the state one notch — also a labeled heuristic.")
crush_exit = input.float(70.0, "Crush episode ends below percentile", minval = 40.0, maxval = 85.0, step = 1.0, group = grp_st,
     tooltip = "An episode opens when the percentile crosses up through the STRESS cut and completes when it falls back below this exit. Episode length is counted in days and stored (last 50). Counted history — not a prediction of the current spike.")
min_epi_n = input.int(5, "Thin-sample flag below n episodes", minval = 1, maxval = 50, group = grp_st)

use_regime_link = input.bool(false, "Show external regime link (context row)", group = grp_link)
regime_src = input.source(close, "Regime link (wire to a REGIME_EXPORT)", group = grp_link,
     tooltip = "Optional. Wire to the flagship engine's REGIME_EXPORT (-1/0/+1) to see the suite regime next to the IV state. Context only — neither source gates the other here.")

hud_mode = input.string("Full", "HUD mode", options = ["Off", "Micro", "Full"], group = grp_dsp)
hud_pos_in = input.string("top_right", "HUD position", options = ["top_left", "top_center", "top_right", "bottom_left", "bottom_center", "bottom_right"], group = grp_dsp)
show_state_tint = input.bool(true, "State background tint (ELEVATED/STRESS)", group = grp_dsp)
use_json_alerts = input.bool(false, "JSON alert payloads (webhook)", group = grp_dsp,
     tooltip = "OFF: human-readable alert text. ON: machine-readable JSON for webhook automation. Display-layer only.")

// =============================================================================
// Palette & helpers (suite standard)
// =============================================================================
c_bull  = color.rgb(89, 159, 125)
c_bear  = color.rgb(190, 96, 111)
c_neut  = color.rgb(112, 126, 148)
c_gold  = color.rgb(214, 162, 82)
c_panel = color.new(#0E1316, 5)
c_cell  = color.new(#151D22, 7)
c_frame = color.new(#5BD6B0, 88)
c_text  = color.white
c_dim   = color.new(color.white, 45)
c_faint = color.new(color.white, 68)

f_pos(_s) =>
    switch _s
        "top_left"      => position.top_left
        "top_center"    => position.top_center
        "top_right"     => position.top_right
        "bottom_left"   => position.bottom_left
        "bottom_center" => position.bottom_center
        "bottom_right"  => position.bottom_right
        => position.top_right
f_fmt(_x, _d) =>
    _m = math.pow(10.0, _d)
    na(_x) ? "n/a" : str.tostring(math.round(_x * _m) / _m)
f_tcell(_tbl, _c, _r, _txt, _col, _bg) =>
    table.cell(_tbl, _c, _r, _txt, text_color = _col, bgcolor = _bg, text_size = size.tiny, text_halign = text.align_center)
f_state_txt(_s) =>
    _s == 0 ? "LOW" : _s == 1 ? "NORMAL" : _s == 2 ? "ELEVATED" : "STRESS"
f_state_col(_s) =>
    _s == 0 ? c_bull : _s == 1 ? c_neut : _s == 2 ? c_gold : c_bear

// =============================================================================
// Index vol complex — completed daily values only ([1] + lookahead_on idiom).
// ignore_invalid_symbol=true: unavailable symbols return na, rows read n/a.
// =============================================================================
[vix_c, vix_pr] = request.security(vix_sym, "D", [close[1], ta.percentrank(close, pct_len)[1]],
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
vix3m_c = request.security(vix3m_sym, "D", close[1],
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)

data_ok = not na(vix_c)
warmed = not na(vix_pr)
term_ratio = not na(vix_c) and not na(vix3m_c) and vix3m_c > 0 ? vix_c / vix3m_c : float(na)
backwardation = not na(term_ratio) and term_ratio > 1.0

int state_base = na(vix_pr) ? int(na) : vix_pr < cut_low ? 0 : vix_pr < cut_elev ? 1 : vix_pr < cut_stress ? 2 : 3
int iv_state = na(state_base) ? int(na) : backwardation ? math.min(state_base + 1, 3) : state_base

new_day = ta.change(time("D")) != 0
var int days_seen = 0
if barstate.isconfirmed and new_day and data_ok
    days_seen += 1

// =============================================================================
// Crush proxy — counted spike-decay episodes (days from stress-cut upcross
// back below the exit cut; ring of 50 completed episodes)
// =============================================================================
var bool watch_on = false
var int watch_days = 0
var float prev_pr = na
var array<float> epi = array.new_float()
if barstate.isconfirmed and new_day and not na(vix_pr)
    if watch_on
        watch_days += 1
        if vix_pr < crush_exit
            if array.size(epi) >= 50
                array.shift(epi)
            array.push(epi, watch_days)
            watch_on := false
    else if not na(prev_pr) and prev_pr < cut_stress and vix_pr >= cut_stress
        watch_on := true
        watch_days := 0
    prev_pr := vix_pr
epi_n = array.size(epi)
crush_med = epi_n > 0 ? array.median(epi) : float(na)

// State escalation (confirmed daily values only; de-escalation is not alerted)
var int prev_state = na
bool esc_ev = barstate.isconfirmed and not na(iv_state) and not na(prev_state) and iv_state > prev_state
if barstate.isconfirmed and not na(iv_state)
    prev_state := iv_state

// Regime link (context row only; strict {-1,0,+1} validation)
_rv = regime_src
link_valid = use_regime_link and not na(_rv) and (_rv == -1.0 or _rv == 0.0 or _rv == 1.0)
link_txt = not use_regime_link ? "link off" : not link_valid ? "LINK?" : _rv == 1.0 ? "BULL" : _rv == -1.0 ? "BEAR" : "NEUTRAL"

// =============================================================================
// Plot, tint, exports
// =============================================================================
plot(warmed ? vix_pr : na, "VIX percentile (252d)", color = na(iv_state) ? c_neut : f_state_col(iv_state), linewidth = 2)
hline(cut_low, "LOW cut", color = color.new(color.white, 85), linestyle = hline.style_dotted)
hline(cut_elev, "ELEVATED cut", color = color.new(color.white, 80), linestyle = hline.style_dotted)
hline(cut_stress, "STRESS cut", color = color.new(color.white, 70), linestyle = hline.style_dashed)
bgcolor(show_state_tint and not na(iv_state) and iv_state == 3 ? color.new(c_bear, 85) :
     show_state_tint and not na(iv_state) and iv_state == 2 ? color.new(c_gold, 90) : na, title = "IV state tint")

plot(na(iv_state) ? na : float(iv_state), "IVP_STATE_EXPORT", color = color.new(color.white, 100), display = display.data_window)
plot(vix_pr, "IVP_PCTILE_EXPORT", color = color.new(color.white, 100), display = display.data_window)
plot(term_ratio, "IVP_TERM_RATIO_EXPORT", color = color.new(color.white, 100), display = display.data_window)
plot(crush_med, "IVP_CRUSH_MEDIAN_EXPORT", color = color.new(color.white, 100), display = display.data_window)
plot(float(epi_n), "IVP_EPISODE_N_EXPORT", color = color.new(color.white, 100), display = display.data_window)

// =============================================================================
// HUD
// =============================================================================
var table hud = table.new(f_pos(hud_pos_in), 2, 8, bgcolor = c_panel, frame_color = c_frame,
     frame_width = 1, border_color = color.new(color.white, 92), border_width = 1)
if barstate.islast and hud_mode != "Off"
    _state_txt = not data_ok ? "DATA n/a — check symbols" :
         not warmed ? "WARMING · " + str.tostring(math.min(days_seen, pct_len)) + "/" + str.tostring(pct_len) + "d" :
         f_state_txt(iv_state) + (backwardation ? " · BW↑" : "")
    _state_bg = not data_ok or not warmed ? c_cell : color.new(f_state_col(iv_state), 45)
    f_tcell(hud, 0, 0, "IV Proxy " + variant_tag, c_text, c_frame)
    f_tcell(hud, 1, 0, _state_txt, c_text, _state_bg)
    if hud_mode == "Full"
        f_tcell(hud, 0, 1, "VIX close · pctile", c_dim, c_panel)
        f_tcell(hud, 1, 1, f_fmt(vix_c, 2) + " · " + f_fmt(vix_pr, 0) + "th (" + str.tostring(pct_len) + "d)", c_dim, c_cell)
        f_tcell(hud, 0, 2, "Term VIX/VIX3M", c_dim, c_panel)
        f_tcell(hud, 1, 2, na(term_ratio) ? "n/a" : f_fmt(term_ratio, 3) + (backwardation ? " · BACKWARDATION (stress)" : " · contango"), backwardation ? c_bear : c_dim, c_cell)
        f_tcell(hud, 0, 3, "Crush history (≥" + f_fmt(cut_stress, 0) + "→<" + f_fmt(crush_exit, 0) + ")", c_dim, c_panel)
        f_tcell(hud, 1, 3, epi_n == 0 ? "no completed episodes" : "median " + f_fmt(crush_med, 0) + "d · n" + str.tostring(epi_n) + (epi_n < min_epi_n ? " !" : ""), epi_n < min_epi_n ? c_faint : c_dim, c_cell)
        f_tcell(hud, 0, 4, "Active spike watch", c_dim, c_panel)
        f_tcell(hud, 1, 4, watch_on ? "decaying · " + str.tostring(watch_days) + "d so far (this one may differ)" : "none", watch_on ? c_gold : c_faint, c_cell)
        f_tcell(hud, 0, 5, "Suite regime (context)", c_dim, c_panel)
        f_tcell(hud, 1, 5, link_txt, use_regime_link and not link_valid ? c_bear : c_dim, c_cell)
        f_tcell(hud, 0, 6, "*index vol complex (S&P)", c_faint, c_panel)
        f_tcell(hud, 1, 6, "NOT this symbol's IV — no per-symbol IV on standard feeds", c_faint, c_panel)
        f_tcell(hud, 0, 7, "*crush = counted history", c_faint, c_panel)
        f_tcell(hud, 1, 7, "not a prediction of this spike · never options advice", c_faint, c_panel)

// =============================================================================
// Alerts (confirmed-bar events; formal wording per suite convention)
// =============================================================================
alertcondition(esc_ev, "IV state escalation", "IV Proxy: index-vol state escalated (confirmed daily value)")
if esc_ev
    _st = f_state_txt(iv_state)
    if use_json_alerts
        alert('{"ev":"iv_proxy","sym":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","state":"' + _st + '","vix":' + (na(vix_c) ? "null" : f_fmt(vix_c, 2)) + ',"pctile":' + (na(vix_pr) ? "null" : f_fmt(vix_pr, 1)) + ',"term_ratio":' + (na(term_ratio) ? "null" : f_fmt(term_ratio, 3)) + ',"crush_med_d":' + (na(crush_med) ? "null" : f_fmt(crush_med, 0)) + ',"epi_n":' + str.tostring(epi_n) + ',"variant":"' + variant_tag + '","t":' + str.tostring(time) + '}', alert.freq_once_per_bar_close)
    else
        alert("IV Proxy [" + variant_tag + "]: index-vol state escalated to " + _st +
             " · VIX " + f_fmt(vix_c, 2) + " (" + f_fmt(vix_pr, 0) + "th pctile) · term " + f_fmt(term_ratio, 3) +
             (backwardation ? " BACKWARDATION" : "") + " · index context, not " + syminfo.ticker + " IV", alert.freq_once_per_bar_close)

// =============================================================================
// End of file · IV Regime Detector & Crush Proxy v1.0
// =============================================================================
